CREATE TABLE User (
    id TEXT NOT NULL PRIMARY KEY,
    username TEXT NOT NULL,
    displayName TEXT NOT NULL,
    role TEXT NOT NULL,
    createdAt TEXT NOT NULL
);

selectAll:
SELECT * FROM User;

selectById:
SELECT * FROM User WHERE id = ?;

insertOrReplace:
INSERT OR REPLACE INTO User(id, username, displayName, role, createdAt)
VALUES (?, ?, ?, ?, ?);
