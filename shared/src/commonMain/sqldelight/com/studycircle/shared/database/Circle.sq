CREATE TABLE CircleEntity (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    joinCode TEXT NOT NULL,
    supervisorId TEXT NOT NULL,
    createdAt TEXT NOT NULL,
    isActive INTEGER NOT NULL
);

CREATE TABLE CircleMember (
    circleId TEXT NOT NULL,
    userId TEXT NOT NULL,
    PRIMARY KEY (circleId, userId)
);

selectAllCircles:
SELECT * FROM CircleEntity;

selectCircleById:
SELECT * FROM CircleEntity WHERE id = ?;

insertOrReplaceCircle:
INSERT OR REPLACE INTO CircleEntity(id, name, joinCode, supervisorId, createdAt, isActive)
VALUES (?, ?, ?, ?, ?, ?);

selectMembers:
SELECT userId FROM CircleMember WHERE circleId = ?;

insertMember:
INSERT OR IGNORE INTO CircleMember(circleId, userId) VALUES (?, ?);

-- Offline fallback for "my circles": the device may hold circles cached for a
-- previous login, so the read is always scoped to the current user.
selectCirclesForUser:
SELECT * FROM CircleEntity
WHERE supervisorId = :userId
   OR id IN (SELECT circleId FROM CircleMember WHERE userId = :userId);

-- A successful GET /circles is authoritative: replace the cache wholesale so a
-- circle the user left/lost access to doesn't linger offline.
deleteAllCircles:
DELETE FROM CircleEntity;

deleteAllMembers:
DELETE FROM CircleMember;
